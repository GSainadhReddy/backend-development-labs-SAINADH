    {
      "name": "9. Protected Profile Demo - Valid Token (GET /profile)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Authorized user returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.tokenPayload.username).to.equal(\"sainadh_reddy\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{jwt_token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/profile",
          "host": ["{{baseUrl}}"],
          "path": ["profile"]
        },
        "description": "Demonstration route verifying the JWT token using jwt.verify and returning the authorized profile."
      },
      "response": []
    },
