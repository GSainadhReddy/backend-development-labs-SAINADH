      "name": "1. GET /books/ (All Books)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Fetches all books from the SQLite database table `book` ordered by id."
      },
      "response": []
    },
    {
      "name": "2. GET /books/:bookId/ (Single Book by ID)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books/1/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "1", ""]
        },
        "description": "Fetches a single book by ID using parameterized query with ? placeholder."
      },
      "response": []
    },
    {
      "name": "3. POST /books/ (Add New Book)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"price\": 799,\n  \"pages\": 616\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/",
          "host": ["{{baseUrl}}"],
          "path": ["books", ""]
        },
        "description": "Inserts a new book into the SQLite database and returns the generated bookId."
      },
      "response": []
    },
    {
      "name": "4. PUT /books/:bookId/ (Update Existing Book)",
      "request": {
        "method": "PUT",
