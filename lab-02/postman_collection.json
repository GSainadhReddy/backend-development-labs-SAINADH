            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Designing Data-Intensive Applications (2nd Edition)\",\n  \"author\": \"Martin Kleppmann\",\n  \"price\": 899,\n  \"pages\": 650\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/books/11/",
          "host": ["{{baseUrl}}"],
          "path": ["books", "11", ""]
        },
        "description": "Updates details of an existing book by ID using parameterized UPDATE query."
      },
      "response": []
    },
    {
      "name": "5. DELETE /books/:bookId/ (Remove Book)",
      "request": {
        "method": "DELETE",
