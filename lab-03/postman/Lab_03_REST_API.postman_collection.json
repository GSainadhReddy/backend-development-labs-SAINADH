        {
          "name": "POST /books - Create Book (201 Created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Designing Data-Intensive Applications\",\n  \"author\": \"Martin Kleppmann\",\n  \"price\": 45.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response returns created book with generated ID', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.message).to.eql('Book created successfully');",
                  "    pm.expect(json.data).to.have.property('id');",
                  "    pm.expect(json.data.title).to.eql('Designing Data-Intensive Applications');",
                  "    pm.collectionVariables.set('createdBookId', json.data.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books/:id - Get Book By ID (200 OK)",
          "request": {
