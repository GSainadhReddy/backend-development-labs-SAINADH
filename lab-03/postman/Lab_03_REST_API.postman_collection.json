    {
      "name": "1. Success Cases",
      "item": [
        {
          "name": "GET /books - Default List & Pagination",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Response includes status success and pagination metadata', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "    pm.expect(json).to.have.property('total');",
                  "    pm.expect(json.limit).to.eql(10);",
                  "    pm.expect(json.offset).to.eql(0);",
                  "    pm.expect(Array.isArray(json.data)).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books - Search by Title (search_q)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=Clean",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "search_q",
                  "value": "Clean"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned books contain search keyword in title', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.data.length).to.be.above(0);",
                  "    json.data.forEach(function(b) {",
                  "        pm.expect(b.title.toLowerCase()).to.include('clean');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books - Sort Descending by Price",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "order_by",
                  "value": "price"
                },
                {
                  "key": "order",
                  "value": "DESC"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Results are sorted descending by price', function () {",
                  "    var json = pm.response.json();",
                  "    for (var i = 1; i < json.data.length; i++) {",
                  "        pm.expect(json.data[i-1].price).to.be.at.least(json.data[i].price);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "GET /books - Price Range Filter (min_price & max_price)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=30&max_price=50",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "min_price",
                  "value": "30"
                },
                {
                  "key": "max_price",
                  "value": "50"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('All returned book prices are between min_price and max_price', function () {",
                  "    var json = pm.response.json();",
                  "    json.data.forEach(function(b) {",
                  "        pm.expect(b.price).to.be.at.least(30);",
                  "        pm.expect(b.price).to.be.at.most(50);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
